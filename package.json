  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vue-tsc": "^3.3.14"
  }
}
